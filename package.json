{
  "name": "telegram-bingo-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @bingo/shared && concurrently -n api,mini -c cyan,magenta \"npm run dev -w @bingo/api\" \"npm run dev -w @bingo/mini-app\"",
    "build": "npm run build -w @bingo/shared && npm run build -w @bingo/api && npm run build -w @bingo/mini-app",
    "typecheck": "npm run build -w @bingo/shared && npm run typecheck -w @bingo/api && npm run typecheck -w @bingo/mini-app",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:dev": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "seed": "npm run seed -w @bingo/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
