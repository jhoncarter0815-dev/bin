# Public URLs
PUBLIC_APP_URL=https://your-mini-app.example.com
API_URL=https://your-api.example.com
MINI_APP_DEV_URL=http://localhost:5173

# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_BOT_USERNAME=YourBingoBot
TELEGRAM_ANNOUNCE_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
SUPPORT_CONTACT=@YourSupportUsername
DEPOSIT_INSTRUCTIONS=Submit a deposit request in the Wallet tab and include payment proof or transaction ID.
WITHDRAW_INSTRUCTIONS=Submit a withdrawal request in the Wallet tab and include payout details.

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-long-random-admin-secret
ADMIN_TELEGRAM_IDS=123456789
ALLOW_DEV_LOGIN=true
CORS_ORIGINS=http://localhost:5173,https://your-mini-app.example.com

# Database
# Production must point to persistent PostgreSQL. Do not use a container-local
# database without a durable volume, or balances will not survive redeploys.
DATABASE_URL=postgresql://bingo:bingo@localhost:5432/bingo?schema=public

# Game settings
PUBLIC_ROOM_SECONDS=30
PUBLIC_ROOM_MIN_PLAYERS=2
PUBLIC_ROOM_MAX_SEATS=200
DRAW_INTERVAL_MS=2500
PUBLIC_ENTRY_FEE=50
# Only used when creating a brand-new user. Existing wallet balances are never
# reset by login, bot restart, or app restart.
STARTING_CREDITS=1000
REFERRAL_REWARD_CREDITS=100
